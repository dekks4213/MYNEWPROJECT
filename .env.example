# Copy to .env and fill in. Never commit .env.
# Passwords are embedded in connection URLs: use URL-safe values, e.g. `openssl rand -hex 24`.
POSTGRES_PASSWORD=change-me
FITCOACH_OWNER_PASSWORD=change-me
FITCOACH_APP_PASSWORD=change-me

APP_NAME=Fit Coach
BOT_TOKEN=
# polling (development / simple hosting) or webhook (needs HTTPS reverse proxy)
BOT_MODE=polling
# Webhook mode only: public HTTPS base URL and a random secret (>= 32 chars).
WEBHOOK_BASE_URL=
WEBHOOK_SECRET=

# AI: disabled | mock | gemini. Manual logging always works.
AI_PROVIDER=disabled
GEMINI_API_KEY=
# Set explicitly after checking the model is available to your key and region.
GEMINI_MODEL=
AI_USER_DAILY_CALLS=20
AI_GLOBAL_DAILY_CALLS=200

LOG_LEVEL=INFO
