# Copy to .env and fill in. Never commit .env.
# Passwords are embedded in connection URLs: use URL-safe values, e.g. `openssl rand -hex 24`
# (PowerShell: -join ((48..57)+(97..102) | Get-Random -Count 40 | % {[char]$_})).
POSTGRES_PASSWORD=change-me
FITCOACH_OWNER_PASSWORD=change-me
FITCOACH_APP_PASSWORD=change-me

# Branding (configuration, not code)
APP_NAME=РИТМ
APP_NAME_EN=RITM

BOT_TOKEN=
# polling (no inbound ports; recommended for a home/Windows server) or webhook (HTTPS proxy)
BOT_MODE=polling
# Webhook mode only: public HTTPS base URL and a random secret (>= 32 chars).
WEBHOOK_BASE_URL=
WEBHOOK_SECRET=

# AI: disabled | mock | gemini. Manual logging always works.
AI_PROVIDER=disabled
GEMINI_API_KEY=
# Verified live on 2026-09-29 (see docs/STATUS.md). Re-check availability before changing.
GEMINI_MODEL=gemini-3.5-flash-lite
# Photos and voice: flash-lite mis-transcribed speech in our test; flash was correct.
GEMINI_MEDIA_MODEL=gemini-3.5-flash
AI_USER_DAILY_CALLS=40
AI_USER_DAILY_MEDIA_CALLS=15
AI_GLOBAL_DAILY_CALLS=400
AI_TIMEOUT_SECONDS=45
# Allow labelled per-100 g AI estimates for unbranded foods (true/false)
AI_NUTRIENT_ESTIMATES=true

# Optional external food databases: "off", "usda" or "off,usda". Empty = disabled.
# USDA FoodData Central needs a free key from https://fdc.nal.usda.gov/api-key-signup
FOOD_SOURCES=
USDA_API_KEY=

REMINDERS_ENABLED=true
LOG_LEVEL=INFO
